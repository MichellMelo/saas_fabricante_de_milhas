# Local development only; never commit production credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fabricante_milhas?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
API_PORT=4000
CORS_ORIGIN="http://localhost:3000"

ADMIN_EMAILS="admin@example.com"
# Temporary first-admin bootstrap. Set only immediately before bootstrap and remove immediately after success.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_TOKEN=""
# Public web origin used to build invitation links
WEB_BASE_URL="http://localhost:3000"
# Optional automatic admin-invitation delivery through Resend; without these, copy the one-time invite link manually.
RESEND_API_KEY=""
EMAIL_FROM="Fabricante de Milhas <acessos@example.com>"
# Machine-to-machine import for flight history. Configure real values only in the runtime environment.
FLIGHT_HISTORY_IMPORT_TOKEN="replace-with-a-random-secret-of-at-least-32-characters"
FLIGHT_HISTORY_IMPORT_USER_ID="replace-with-the-target-User-id"
