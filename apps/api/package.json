{
  "name": "@fabricante/api",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "build": "node scripts/prisma-with-env.cjs generate && nest build",
    "start": "nest start",
    "start:dev": "node scripts/prisma-with-env.cjs generate && nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "node scripts/prisma-with-env.cjs generate && tsc --noEmit",
    "prisma:generate": "node scripts/prisma-with-env.cjs generate",
    "prisma:migrate": "node scripts/prisma-with-env.cjs migrate dev",
    "prisma:deploy": "node scripts/prisma-with-env.cjs migrate deploy",
    "prisma:status": "node scripts/prisma-with-env.cjs migrate status",
    "prisma:studio": "node scripts/prisma-with-env.cjs studio",
    "prisma:seed": "node prisma/seed.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.11",
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "prisma": "^6.6.0",
    "typescript": "^5.8.2"
  }
}
