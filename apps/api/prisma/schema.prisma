generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
enum LoyaltyProgramType {
 BANK
 AIRLINE
 HOTEL
 OTHER
}
enum TransactionType {
 EARN
 TRANSFER_IN
 TRANSFER_OUT
 REDEMPTION
 PURCHASE
 EXPIRATION
 ADJUSTMENT
}
enum ProductType {
 GROUP_VIP
 AULAO
 MENTORSHIP
}
enum SubscriptionPeriod {
 MONTHLY
 SEMIANNUAL
 ANNUAL
 CUSTOM
}
enum PaymentStatus {
 PENDING
 PAID
 CANCELLED
}
enum PaymentMethod {
 PIX
 BANK_TRANSFER
 CREDIT_CARD
 CASH
 OTHER
}
model User {
 id String @id @default(cuid())
 email String @unique
 passwordHash String?
 active Boolean @default(true)
 name String?
 phone String?
 notes String? @db.Text
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 loyaltyAccounts LoyaltyAccount[]
 customLoyaltyPrograms LoyaltyProgram[]
 transactions PointTransaction[]
 flights FlightRecord[]
 productAccesses UserProductAccess[]
 payments ClientPayment[]
 sentInvitations ClientInvitation[] @relation("InvitationSender")
 authoredGroupVipPosts GroupVipPost[]
}
model LoyaltyProgram {
 id String @id @default(cuid())
 name String
 code String @unique
 type LoyaltyProgramType @default(OTHER)
 active Boolean @default(true)
 ownerUserId String?
 createdAt DateTime @default(now())
 owner User? @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
 accounts LoyaltyAccount[]
 @@index([ownerUserId])
}
model LoyaltyAccount {
 id String @id @default(cuid())
 userId String
 loyaltyProgramId String
 memberReference String?
 balance Decimal @default(0) @db.Decimal(18, 2)
 currency String @default("POINTS")
 lastBalanceAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 loyaltyProgram LoyaltyProgram @relation(fields: [loyaltyProgramId], references: [id], onDelete: Restrict)
 transactions PointTransaction[]
 @@unique([userId, loyaltyProgramId])
 @@index([userId])
 @@index([loyaltyProgramId])
}
model PointTransaction {
 id String @id @default(cuid())
 userId String
 loyaltyAccountId String?
 type TransactionType
 points Decimal @db.Decimal(18, 2)
 unitCostBrl Decimal? @db.Decimal(12, 4)
 cashValueBrl Decimal? @db.Decimal(12, 2)
 occurredAt DateTime @default(now())
 notes String?
 createdAt DateTime @default(now())
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 loyaltyAccount LoyaltyAccount? @relation(fields: [loyaltyAccountId], references: [id], onDelete: SetNull)
 @@index([userId, occurredAt])
 @@index([loyaltyAccountId, occurredAt])
}
model FlightRecord {
 id String @id @default(cuid())
 userId String
 airline String
 flightNumber String?
 origin String
 destination String
 departureAt DateTime?
 arrivalAt DateTime?
 bookingReference String?
 pointsRedeemed Decimal? @db.Decimal(18, 2)
 taxesBrl Decimal? @db.Decimal(12, 2)
 createdAt DateTime @default(now())
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@index([userId, departureAt])
}
model UserProductAccess {
 id String @id @default(cuid())
 userId String
 product ProductType
 period SubscriptionPeriod @default(MONTHLY)
 active Boolean @default(true)
 startsAt DateTime @default(now())
 expiresAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@unique([userId, product])
 @@index([product, active])
 @@index([userId, active])
}
model ClientInvitation {
 id String @id @default(cuid())
 email String
 name String?
 tokenHash String @unique
 productTypes ProductType[]
 invitedByUserId String
 expiresAt DateTime
 acceptedAt DateTime?
 createdAt DateTime @default(now())
 invitedBy User @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)
 @@index([email, acceptedAt])
 @@index([expiresAt])
}

model GroupVipPost {
 id String @id @default(cuid())
 title String @db.VarChar(180)
 summary String? @db.VarChar(300)
 body String @db.Text
 externalUrl String? @db.VarChar(2048)
 isPublished Boolean @default(false)
 publishedAt DateTime?
 authorId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
 @@index([isPublished, publishedAt])
 @@index([authorId, createdAt])
}

model ClientPayment {
 id String @id @default(cuid())
 userId String
 product ProductType
 amount Decimal @db.Decimal(12, 2)
 dueAt DateTime
 status PaymentStatus @default(PENDING)
 method PaymentMethod?
 paidAt DateTime?
 notes String? @db.Text
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@index([userId, dueAt])
 @@index([status, dueAt])
}
